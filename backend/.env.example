PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_system
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Serial Port (Weight Scale)
SCALE_PORT=COM3
SCALE_BAUD_RATE=9600

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
